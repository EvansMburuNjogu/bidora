{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "local:platform-otp": "node scripts/copy-local-admin-otp.mjs",
    "local:platform-otp:watch": "node scripts/copy-local-admin-otp.mjs --watch",
    "contracts:generate": "node scripts/generate-auth-contracts.mjs",
    "contracts:check": "node scripts/generate-auth-contracts.mjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test:platform": "node --test tests/platform-*.test.mjs",
    "test:platform:feedback": "node --test tests/platform-submission-feedback.browser.mjs",
    "test:auth": "node --test tests/auth/*.test.mjs",
    "test:auth:fast": "node --test tests/auth/accepted-response.test.mjs tests/auth/login-challenge.test.mjs tests/auth/source-security.test.mjs tests/auth/invitation-continuation.test.mjs",
    "test:auth:bff": "node --test tests/auth/bff-boundary.test.mjs",
    "verify:auth": "npm run verify:auth:fast",
    "verify:auth:fast": "npm run contracts:check",
    "verify:auth:full": "npm run contracts:check && npm run lint && tsc --noEmit && npm run build",
    "verify:auth:with-tests": "npm run contracts:check && npm run lint && tsc --noEmit && npm run test:auth && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.63.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "countries-and-timezones": "3.11.0",
    "countries-list": "3.4.1",
    "country-to-currency": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}

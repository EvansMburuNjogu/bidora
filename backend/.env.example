# Explicit local-only, dependency-free health profile; no business readiness.
BIDORA_ENV=local
BIDORA_PROFILE=health-only
BIDORA_HTTP_ADDR=127.0.0.1:8080

# pilot-api only: explicit versioned MFA key ring; each referenced file contains
# exactly one base64-encoded 32-byte AES-256 key. Never commit key files.
# BIDORA_MFA_KEY_VERSION=1
# BIDORA_MFA_KEY_VERSIONS=1
# BIDORA_MFA_KEY_1_FILE=/run/secrets/bidora_mfa_key_v1

# Ordinary login email-code HMAC key: exactly 32 random bytes encoded with
# unpadded standard base64. Required whenever authenticated STARTTLS SMTP is
# enabled; never reuse the attempt-limiter or MFA encryption keys.
# BIDORA_EMAIL_LOGIN_HMAC_SECRET_B64=<external-secret-reference>

# Database-managed SMTP vault: file contains exactly one base64-encoded
# 32-byte AES-256-GCM key. The key stays outside PostgreSQL and source control.
# Without it, SMTP mutation routes are not mounted and ordinary login bypasses
# email OTP; ownership verification/recovery email remains unavailable.
# BIDORA_SMTP_VAULT_KEY_FILE=/run/secrets/bidora_smtp_vault_key_v1
# BIDORA_SMTP_VAULT_KEY_VERSION=1

# Optional durable verification/recovery notification-attempt evidence.
# Independent private file containing a base64-encoded 32-byte HMAC key.
# Requires the SMTP vault above; never reuse vault/login/MFA keys.
# Both values are required together; no ambient/default key is generated.
# BIDORA_NOTIFICATION_FINGERPRINT_KEY_FILE=/run/secrets/bidora_notification_fingerprint_v1
# BIDORA_NOTIFICATION_FINGERPRINT_KEY_VERSION=1

# pilot-api TP-F09 only: an existing deployment-owned JetStream stream and
# durable consumer must match the fixed source contract. The credentials file
# must be private and is never logged or committed.
# BIDORA_NATS_URL=tls://nats.example.invalid:4222
# BIDORA_NATS_CREDENTIALS_FILE=/run/secrets/bidora_nats.creds
# BIDORA_NATS_CA_FILE=/run/secrets/bidora_nats_ca.pem
# BIDORA_NATS_TLS_SERVER_NAME=nats.example.invalid
# BIDORA_NATS_CONNECT_TIMEOUT_SECONDS=10
# BIDORA_DOCUMENT_MEASURER_PATH=/opt/bidora/bin/document-measurer
# Explicit Poppler pdftotext executable used only for bounded local Unicode counting.
# BIDORA_PDFTOTEXT_PATH=/usr/bin/pdftotext

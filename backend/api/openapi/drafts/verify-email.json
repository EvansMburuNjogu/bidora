{
  "openapi": "3.1.0",
  "info": {
    "title": "Bidora pilot email verification",
    "version": "0.2.0-draft",
    "description": "Consumes one approved email-ownership token atomically. It creates no session, membership, capability, or tenant context."
  },
  "x-status": "implemented-and-composed-provider-acceptance-pending",
  "x-approval": {
    "date": "2026-10-18",
    "owner": "requesting user",
    "evidence": "approved email verification token policy and subsequent proceed",
    "remaining": ["deployment load protection", "external SMTP/browser acceptance"]
  },
  "paths": {
    "/v1/auth/verify-email/resend": {
      "post": {
        "operationId": "resendEmailVerification",
        "summary": "Request a replacement email verification token",
        "description": "Returns the same accepted response for unknown, malformed, verified, disabled and delivery-ambiguous targets. Every request consumes the approved fail-closed registration identity and network limits. A successful issuance atomically invalidates the previous active token before delivery. This operation creates no session or authority.",
        "security": [],
        "parameters": [
          {"name": "Origin", "in": "header", "required": true, "schema": {"type": "string", "format": "uri"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["email"],
                "properties": {
                  "email": {"type": "string", "minLength": 1, "maxLength": 254}
                }
              }
            }
          }
        },
        "responses": {
          "202": {"description": "Generic accepted response. Delivery and account existence are not disclosed."},
          "400": {"$ref": "#/components/responses/Failure"},
          "403": {"$ref": "#/components/responses/Failure"},
          "413": {"$ref": "#/components/responses/Failure"},
          "415": {"$ref": "#/components/responses/Failure"},
          "429": {"description": "Fail-closed attempt denial with Retry-After: 900.", "headers": {"Retry-After": {"schema": {"type": "integer", "const": 900}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "503": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/v1/auth/verify-email": {
      "post": {
        "operationId": "verifyEmailOwnership",
        "summary": "Consume an email verification token",
        "description": "Requires an exact approved HTTPS Origin. The token is supplied only in a strict JSON body, never in the URL. Invalid, expired, consumed and unknown tokens return the same failure. Success does not authenticate the browser or grant tenant authority.",
        "security": [],
        "parameters": [
          {"name": "Origin", "in": "header", "required": true, "schema": {"type": "string", "format": "uri"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["token"],
                "properties": {
                  "token": {"type": "string", "minLength": 43, "maxLength": 43}
                }
              }
            }
          }
        },
        "responses": {
          "204": {"description": "Email ownership verified. No body, cookies, or session."},
          "400": {"description": "Malformed request or generic invalid, expired, unknown, or consumed token.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "403": {"$ref": "#/components/responses/Failure"},
          "413": {"$ref": "#/components/responses/Failure"},
          "415": {"$ref": "#/components/responses/Failure"},
          "503": {"$ref": "#/components/responses/Failure"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "field_errors", "trace_id", "retryable"],
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "field_errors": {"type": "array", "items": {"type": "object"}},
              "trace_id": {"type": "string"},
              "retryable": {"type": "boolean"}
            }
          }
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "Safe failure without token, identity, or dependency details.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
      }
    }
  }
}

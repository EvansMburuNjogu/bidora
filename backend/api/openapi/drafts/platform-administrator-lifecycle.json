    "/v1/platform/administrator-changes": {
      "post": {
        "operationId": "createPlatformAdministratorChange",
        "summary": "Create an exact administrator role or identity-state change",
        "description": "ASSIGN_ROLE and REVOKE_ROLE require the corresponding Platform Owner capability. DISABLE_IDENTITY permits Platform Owner or Security and Audit authority for non-owner targets; Owner targets and REACTIVATE_IDENTITY require Platform Owner authority. DELETE_IDENTITY requires a fresh Platform Owner, a different already-disabled account, matching versions and no tenant ties. It physically removes the user and sign-in secrets, invalidates outstanding administrator offers, releases the email and atomically records deletion evidence/idempotency. Historical references retain only a non-login identity ID; immutable business/audit history is not erased and a fresh account receives a new ID with no inherited grants. Every action requires accepted administrator AAL2 no older than 15 minutes and exact target/context versions. New changes execute atomically with audit/outbox evidence and no separate checker, advance the target security context and revoke existing sessions. Final-effective-owner continuity is rechecked under lock. Self-targeted identity-state changes and self-grants are denied; role bundles cannot be edited. Legacy approval records are never auto-executed.",
        "security": [{"browserSession": [], "csrfCookie": []}],
        "parameters": [
          {"$ref": "#/components/parameters/Origin"},
          {"$ref": "#/components/parameters/CSRF"},
          {"$ref": "#/components/parameters/PlatformContextGeneration"},
          {"$ref": "#/components/parameters/Idempotency"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdministratorChangeRequest"}}}},
        "responses": {
          "201": {"description": "New change committed as EXECUTED; legacy replay may report an existing pending record.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdministratorChangeResponse"}}}},
          "400": {"$ref": "#/components/responses/Failure"},
          "401": {"$ref": "#/components/responses/Failure"},
          "403": {"$ref": "#/components/responses/Failure"},
          "404": {"$ref": "#/components/responses/Failure"},
          "409": {"$ref": "#/components/responses/Failure"},
          "413": {"$ref": "#/components/responses/Failure"},
          "415": {"$ref": "#/components/responses/Failure"},
          "503": {"$ref": "#/components/responses/Failure"}
        }
      },

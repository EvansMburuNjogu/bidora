        "responses": {
          "201": {"description": "New invitation committed as ACTIVE; legacy idempotent replay may report PENDING_APPROVAL.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvitationResponse"}}}},
          "400": {"$ref": "#/components/responses/Failure"},
          "401": {"$ref": "#/components/responses/Failure"},
          "403": {"$ref": "#/components/responses/Failure"},

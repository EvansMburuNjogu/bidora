    "/v1/platform/administrator-invitations/accept": {
      "post": {
        "operationId": "acceptPlatformAdministratorInvitation",
        "summary": "Accept a Platform Admin invitation",
        "description": "Requires an authenticated verified, enabled UNASSIGNED user with the exact invited email, no tenant ties and actual EMAIL_OTP proof at AAL1 or AAL2 no older than 15 minutes or the tighter configured freshness window. The strict 4 KiB body accepts only the strong invitation token (scoped six digits or legacy opaque token). Existing invitation state, identity binding, tenant exclusions, version and idempotency checks remain authoritative. Success atomically promotes the identity, assigns its saved role, advances auth_epoch, revokes prior sessions, records evidence and inserts the replacement administrator session. Its existing email-proof timestamp is preserved, never refreshed. Browser cookies are replaced only after commit; replacement failure rolls back promotion. Matching replay does not revoke the current browser session.",
        "security": [{"browserSession": [], "csrfCookie": []}],
        "parameters": [
          {"$ref": "#/components/parameters/Origin"},
          {"$ref": "#/components/parameters/CSRF"},
          {"$ref": "#/components/parameters/Idempotency"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AcceptInvitationRequest"}}}},
        "responses": {
          "204": {"description": "Invitation accepted with committed replacement session and CSRF cookies. Continue directly through normal portal resolution; matching replay preserves current cookies."},
          "400": {"$ref": "#/components/responses/Failure"},
          "401": {"$ref": "#/components/responses/Failure"},
          "403": {"$ref": "#/components/responses/Failure"},
          "409": {"$ref": "#/components/responses/Failure"},
          "413": {"$ref": "#/components/responses/Failure"},
          "415": {"$ref": "#/components/responses/Failure"},
          "503": {"$ref": "#/components/responses/Failure"}
        }
      }
    },

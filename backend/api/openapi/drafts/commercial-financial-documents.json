{
  "openapi": "3.1.0",
  "info": {
    "title": "Bidora Commercial Financial Documents",
    "version": "0.2.0-draft",
    "description": "TP-F06 mounts tenant-scoped invoice list and exact reads. Invoice issuance remains separately gated and unmounted."
  },
  "x-status": "tp-f06-reads-mounted-implemented-not-verified",
  "x-policy": "BID-API-011C C1-C15",
  "paths": {
    "/v1/tenderpreneur/commercial/invoices": {
      "post": {
        "operationId": "issueCommercialInvoice",
        "description": "Strict 8 KiB request. Requires current tenderpreneur.organization.subscription.manage, exact tenant context, active reviewed tax profile, current server-owned quote and subscription version. Client cannot supply price, tax, invoice number, billing snapshot, provider state or entitlement effect.",
        "security": [
          {
            "browserSession": [],
            "csrfCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/Tenant"
          },
          {
            "$ref": "#/components/parameters/Context"
          },
          {
            "$ref": "#/components/parameters/Idempotency"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueInvoiceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable issued invoice; no payment or entitlement effect.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "409": {
            "$ref": "#/components/responses/Failure"
          },
          "413": {
            "$ref": "#/components/responses/Failure"
          },
          "415": {
            "$ref": "#/components/responses/Failure"
          },
          "503": {
            "$ref": "#/components/responses/Failure"
          }
        }
      },
      "get": {
        "operationId": "listCommercialInvoices",
        "description": "Requires current tenderpreneur.organization.subscription.read. Bounded newest-first history implemented behind an unmounted handler; opaque cursor values never grant authority.",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/Tenant"
          },
          {
            "$ref": "#/components/parameters/Context"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newest-first tenant invoice page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/InvoiceSummary"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "#/components/responses/Failure"
            },
            "403": {
              "$ref": "#/components/responses/Failure"
            },
            "503": {
              "$ref": "#/components/responses/Failure"
            }
          }
        }
      }
    },
    "/v1/tenderpreneur/commercial/invoices/{invoice_id}": {
      "get": {
        "operationId": "getCommercialInvoice",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/Tenant"
          },
          {
            "$ref": "#/components/parameters/Context"
          }
        ],
        "responses": {
          "200": {
            "description": "Exact immutable invoice.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "404": {
            "$ref": "#/components/responses/Failure"
          },
          "503": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bidora_session"
      },
      "csrfCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bidora_csrf"
      }
    },
    "parameters": {
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uri"
        }
      },
      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43
        }
      },
      "Tenant": {
        "name": "X-Bidora-Tenant-ID",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Context": {
        "name": "X-Bidora-Context-Generation",
        "in": "header",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "Idempotency": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "IssueInvoiceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subscription_id",
          "purchase_operation_id",
          "purchase_kind",
          "plan_key",
          "cadence",
          "quantity",
          "expected_subscription_version"
        ],
        "properties": {
          "subscription_id": {
            "type": "string",
            "format": "uuid"
          },
          "purchase_operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "purchase_kind": {
            "type": "string",
            "enum": [
              "PLAN_BASE",
              "ADDITIONAL_LICENCE"
            ]
          },
          "plan_key": {
            "type": "string",
            "enum": [
              "BASIC",
              "GROWTH",
              "PROFESSIONAL",
              "ENTERPRISE"
            ]
          },
          "cadence": {
            "type": "string",
            "enum": [
              "MONTHLY",
              "ANNUAL",
              "CONTRACT"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "expected_subscription_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "amount_minor_units",
          "amount"
        ],
        "properties": {
          "currency": {
            "const": "KES"
          },
          "amount_minor_units": {
            "type": "integer",
            "minimum": 0
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
          }
        }
      },
      "InvoiceLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_number",
          "line_kind",
          "description_code",
          "quantity",
          "unit_amount",
          "net_amount",
          "tax_code",
          "tax_amount",
          "gross_amount"
        ],
        "properties": {
          "line_number": {
            "type": "integer",
            "minimum": 1
          },
          "line_kind": {
            "type": "string",
            "enum": [
              "PLAN_BASE",
              "ADDITIONAL_LICENCE",
              "APPROVED_CREDIT",
              "VAT"
            ]
          },
          "description_code": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_amount": {
            "$ref": "#/components/schemas/Money"
          },
          "net_amount": {
            "$ref": "#/components/schemas/Money"
          },
          "tax_code": {
            "type": "string"
          },
          "tax_amount": {
            "$ref": "#/components/schemas/Money"
          },
          "gross_amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "InvoiceSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subscription_id",
          "invoice_number",
          "state",
          "version",
          "purchase_kind",
          "plan_key",
          "catalogue_version",
          "cadence",
          "quantity",
          "subtotal",
          "tax",
          "total",
          "outstanding",
          "issued_at",
          "due_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "subscription_id": {
            "type": "string",
            "format": "uuid"
          },
          "invoice_number": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "purchase_kind": {
            "type": "string"
          },
          "plan_key": {
            "type": "string"
          },
          "catalogue_version": {
            "type": "string"
          },
          "cadence": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "subtotal": {
            "$ref": "#/components/schemas/Money"
          },
          "tax": {
            "$ref": "#/components/schemas/Money"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "outstanding": {
            "$ref": "#/components/schemas/Money"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "invoice_number",
          "state",
          "version",
          "purchase_kind",
          "plan_key",
          "catalogue_version",
          "cadence",
          "quantity",
          "term_start",
          "term_end",
          "arithmetic_profile",
          "subtotal",
          "credit",
          "taxable",
          "tax",
          "total",
          "outstanding",
          "issued_at",
          "due_at",
          "lines",
          "payment_initiated",
          "entitlements_activated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "invoice_number": {
            "type": "string",
            "pattern": "^BDR-INV-[0-9]{4}-[0-9]{8}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "ISSUED",
              "PAYMENT_PENDING",
              "PAID",
              "PARTIALLY_CREDITED",
              "CREDITED",
              "VOID",
              "REVIEW_REQUIRED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "purchase_kind": {
            "type": "string",
            "enum": [
              "PLAN_BASE",
              "ADDITIONAL_LICENCE"
            ]
          },
          "plan_key": {
            "type": "string"
          },
          "catalogue_version": {
            "type": "string"
          },
          "cadence": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "term_start": {
            "type": "string",
            "format": "date-time"
          },
          "term_end": {
            "type": "string",
            "format": "date-time"
          },
          "arithmetic_profile": {
            "const": "KES_COMMERCIAL_V1"
          },
          "subtotal": {
            "$ref": "#/components/schemas/Money"
          },
          "credit": {
            "$ref": "#/components/schemas/Money"
          },
          "taxable": {
            "$ref": "#/components/schemas/Money"
          },
          "tax": {
            "$ref": "#/components/schemas/Money"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "outstanding": {
            "$ref": "#/components/schemas/Money"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          },
          "lines": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/InvoiceLine"
            }
          },
          "payment_initiated": {
            "type": "boolean"
          },
          "entitlements_activated": {
            "type": "boolean"
          }
        }
      },
      "InvoiceResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Invoice"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id"
        ],
        "properties": {
          "trace_id": {
            "type": "string"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "Stable safe failure including commercial_tax_profile_unavailable, commercial_quote_stale, version/idempotency conflicts or dependency unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "x-runtime-mounted-operations": [
    "listCommercialInvoices",
    "getCommercialInvoice"
  ],
  "x-runtime-unmounted-operations": [
    "issueCommercialInvoice"
  ]
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Bidora bid archive preparation",
    "version": "0.2.0-draft"
  },
  "paths": {
    "/v1/tenderpreneur/bids/{bid_id}/archive-preparation": {
      "get": {
        "summary": "Assess archive and read-only closure prerequisites without mutating the bid",
        "description": "Reports immutable closure prerequisites. Eligibility requires NO_BID, or SUBMITTED with human confirmation and a current terminal reported outcome; UNKNOWN and PENDING are not terminal. Open review threads, live uploads and active jobs block archive. can_archive is domain eligibility only and never grants authority.",
        "responses": {
          "200": {
            "description": "Read-only archive assessment with archive_policy_configured and read_only_closure_supported true"
          },
          "403": {
            "description": "Bid-read authority required"
          },
          "404": {
            "description": "Bid not found"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "parameters": [
          {
            "name": "bid_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Bidora-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Bidora-Context-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    }
  }
}

  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bidora_session"
      }
    },
    "parameters": {
      "Context": {
        "in": "header",
        "name": "X-Bidora-Platform-Context-Generation",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "CSRF": {
        "in": "header",
        "name": "X-CSRF-Token",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "Key": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Version": {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        }
      },
      "Code": {
        "in": "path",
        "name": "code",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "AuditID": {
        "in": "path",
        "name": "audit_id",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_id"
        ],
        "properties": {
          "trace_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Country": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "country_code",
          "currency",
          "language",
          "timezone",
          "enabled",
          "is_default",
          "name",
          "locale",
          "version",
          "updated_at"
        ],
        "properties": {
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "enabled": {
            "type": "boolean"
          },
          "is_default": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CountryWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "country_code",
          "currency",
          "language",
          "timezone",
          "enabled",
          "is_default"
        ],
        "properties": {
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "enabled": {
            "type": "boolean"
          },
          "is_default": {
            "type": "boolean"
          }
        }
      },
      "CountryReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "currency",
          "language",
          "languages",
          "zone",
          "zones"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "zone": {
            "type": "string"
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OperationalPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization_registration_enabled",
          "ai_features_enabled",
          "document_uploads_enabled",
          "max_document_bytes",
          "maintenance_enabled",
          "maintenance_message",
          "maintenance_starts_at",
          "maintenance_ends_at",
          "restricted_metadata_retention_days",
          "version",
          "updated_at"
        ],
        "properties": {
          "organization_registration_enabled": {
            "type": "boolean"
          },
          "ai_features_enabled": {
            "type": "boolean"
          },
          "document_uploads_enabled": {
            "type": "boolean"
          },
          "max_document_bytes": {
            "type": "integer",
            "minimum": 1048576,
            "maximum": 26214400
          },
          "maintenance_enabled": {
            "type": "boolean"
          },
          "maintenance_message": {
            "type": "string",
            "maxLength": 240,
            "description": "Single-line public message, required when maintenance is enabled; at most 240 UTF-8 bytes."
          },
          "maintenance_starts_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "maintenance_ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "restricted_metadata_retention_days": {
            "type": "integer",
            "minimum": 7,
            "maximum": 90,
            "default": 90,
            "description": "Development restricted metadata visibility, not production retention or physical deletion."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OperationalPolicyWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organization_registration_enabled",
          "ai_features_enabled",
          "document_uploads_enabled",
          "max_document_bytes",
          "maintenance_enabled",
          "maintenance_message",
          "maintenance_starts_at",
          "maintenance_ends_at",
          "restricted_metadata_retention_days"
        ],
        "properties": {
          "organization_registration_enabled": {
            "type": "boolean"
          },
          "ai_features_enabled": {
            "type": "boolean"
          },
          "document_uploads_enabled": {
            "type": "boolean"
          },
          "max_document_bytes": {
            "type": "integer",
            "minimum": 1048576,
            "maximum": 26214400
          },
          "maintenance_enabled": {
            "type": "boolean"
          },
          "maintenance_message": {
            "type": "string",
            "maxLength": 240,
            "description": "Single-line public message, required when maintenance is enabled; at most 240 UTF-8 bytes."
          },
          "maintenance_starts_at": {
            "type": "string",
            "description": "RFC3339 with explicit offset (normalized UTC), or empty string for no bound."
          },
          "maintenance_ends_at": {
            "type": "string",
            "description": "RFC3339 with explicit offset (normalized UTC), or empty string; must follow start."
          },
          "restricted_metadata_retention_days": {
            "type": "integer",
            "minimum": 7,
            "maximum": 90,
            "default": 90,
            "description": "Development restricted metadata visibility, not production retention or physical deletion."
          }
        }
      },
      "SharedCountryOptions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "countries",
          "default_country",
          "billing_currency",
          "organization_registration_enabled"
        ],
        "properties": {
          "countries": {
            "type": "array",
            "maxItems": 300,
            "items": {
              "$ref": "#/components/schemas/Country"
            }
          },
          "default_country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "billing_currency": {
            "const": "KES"
          },
          "organization_registration_enabled": {
            "type": "boolean"
          }
        }
      },
      "RequestMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ip_address",
          "browser",
          "observed_at"
        ],
        "properties": {
          "ip_address": {
            "oneOf": [
              {
                "type": "string",
                "format": "ipv4"
              },
              {
                "type": "string",
                "format": "ipv6"
              }
            ]
          },
          "browser": {
            "type": "string",
            "maxLength": 512,
            "description": "Untrusted browser header; not a device identity or authorization fact."
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "field_errors",
              "trace_id",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "field_errors": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "trace_id": {
                "type": "string",
                "format": "uuid"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "CountryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",

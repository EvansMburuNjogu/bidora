    "/v1/platform/audit/actions/{audit_id}/request-metadata": {
      "get": {
        "operationId": "getRestrictedPlatformRequestMetadata",
        "description": "Exact current context, both platform.audit.read and platform.security.event.read, recent TOTP. Returns only successful authenticated Platform request metadata joined through the tenant-null allowlisted audit projection, within the configured 7–90-day development visibility period. Access appends a minimal immutable audit fact. No data is collected in production by this feature; 404 also covers absent/expired data.",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditID"

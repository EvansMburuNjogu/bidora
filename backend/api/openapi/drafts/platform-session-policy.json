{
  "openapi": "3.1.0",
  "info": {
    "title": "Bidora Platform Session Policy",
    "version": "0.1.0-draft"
  },
  "x-status": "implemented-not-verified",
  "x-owner": "platform_settings",
  "paths": {
    "/v1/platform/security/session-policy": {
      "get": {
        "operationId": "getPlatformSessionPolicy",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "Requires current platform.admin.read and valid administrator AAL2. Reading settings is not a step-up ceremony. Mandatory email verification, session expiry and permissions still apply.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "X-Bidora-Platform-Context-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current or saved policy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "401": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "403": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "409": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "503": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          }
        }
      },
      "put": {
        "operationId": "savePlatformSessionPolicy",
        "security": [
          {
            "browserSession": []
          }
        ],
        "description": "Requires effective Platform Owner authority, session-bound CSRF, exact version/idempotency and recent verification under the saved step-up window. Session limits are persisted without extension; only expired/invalid or excess concurrent sessions are revoked. Unrelated valid users are not signed out. Email verification and assurance timestamps are never reset.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "X-Bidora-Platform-Context-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\"[1-9][0-9]*\"$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current or saved policy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "401": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "403": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "409": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "503": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "idle_seconds",
                  "absolute_seconds",
                  "security"
                ],
                "properties": {
                  "idle_seconds": {
                    "type": "integer",
                    "enum": [
                      300,
                      600,
                      900,
                      1800
                    ]
                  },
                  "absolute_seconds": {
                    "type": "integer",
                    "enum": [
                      3600,
                      14400,
                      28800,
                      43200
                    ]
                  },
                  "security": {
                    "$ref": "#/components/schemas/SecurityControls"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/password-policy": {
      "get": {
        "operationId": "getPublicPasswordRequirements",
        "summary": "Read current requirements for creating a password",
        "security": [],
        "responses": {
          "200": {
            "description": "Current or saved policy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordRequirementsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "409": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          },
          "503": {
            "description": "Safe validation, authentication, authority, conflict or dependency error."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bidora_session"
      }
    },
    "schemas": {
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idle_seconds",
          "absolute_seconds",
          "version",
          "security"
        ],
        "properties": {
          "idle_seconds": {
            "type": "integer",
            "enum": [
              300,
              600,
              900,
              1800
            ]
          },
          "absolute_seconds": {
            "type": "integer",
            "enum": [
              3600,
              14400,
              28800,
              43200
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "security": {
            "$ref": "#/components/schemas/SecurityControls"
          }
        }
      },
      "PolicyResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Policy"
          },
          "meta": {
            "type": "object",
            "required": [
              "trace_id"
            ],
            "properties": {
              "trace_id": {
                "type": "string"
              },
              "next_cursor": {
                "type": "null"
              }
            }
          }
        }
      },
      "SecurityControls": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failed_login_attempts",
          "failure_window_seconds",
          "lockout_seconds",
          "minimum_password_bytes",
          "password_reset_seconds",
          "admin_idle_seconds",
          "admin_absolute_seconds",
          "allow_multiple_sessions"
        ],
        "properties": {
          "failed_login_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "failure_window_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 3600,
            "multipleOf": 60
          },
          "lockout_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 3600,
            "multipleOf": 60
          },
          "minimum_password_bytes": {
            "type": "integer",
            "minimum": 12,
            "maximum": 128
          },
          "password_reset_seconds": {
            "type": "integer",
            "minimum": 300,
            "maximum": 1800,
            "multipleOf": 60
          },
          "admin_idle_seconds": {
            "type": "integer",
            "minimum": 300,
            "maximum": 604800,
            "multipleOf": 60
          },
          "admin_absolute_seconds": {
            "type": "integer",
            "minimum": 3600,
            "maximum": 604800,
            "multipleOf": 60
          },
          "step_up_seconds": {
            "type": "integer",
            "minimum": 300,
            "maximum": 3600,
            "multipleOf": 60,
            "description": "Sensitive Platform action verification window, default 900 seconds. Omission in legacy requests preserves the saved value; ordinary navigation does not use this timer."
          },
          "allow_multiple_sessions": {
            "type": "boolean"
          }
        }
      },
      "PasswordRequirements": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minimum_password_bytes",
          "maximum_password_bytes"
        ],
        "properties": {
          "minimum_password_bytes": {
            "type": "integer",
            "minimum": 12,
            "maximum": 128
          },
          "maximum_password_bytes": {
            "type": "integer",
            "enum": [
              128
            ]
          }
        }
      },
      "PasswordRequirementsResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PasswordRequirements"
          },
          "meta": {
            "type": "object",
            "required": [
              "trace_id"
            ],
            "properties": {
              "trace_id": {
                "type": "string"
              },
              "next_cursor": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": { "title": "PA-17 Platform AI usage read (draft)", "version": "0.1.0" },
  "paths": {
    "/v1/platform/commercial/ai-usage": {
      "get": {
        "summary": "List settled control-plane AI credit measurements, newest first",
        "description": "Current non-support Platform Billing Administrator or Platform Owner with invoice-read or payment-read authority, matching platform context generation and trusted administrator assurance. Every page rechecks authority and commits a control-plane read audit. Tenant headers do not authorize access. Reserved/released operations, estimates, prices, costs, content and totals are excluded. Cursor pagination is not a snapshot; concurrent settlements can appear on a later first page.",
        "parameters": [
          { "name": "X-Bidora-Platform-Context-Generation", "in": "header", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "maxLength": 512 } },
          { "name": "tenant_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "kind", "in": "query", "schema": { "type": "string", "enum": ["DOCUMENT_PDF","DOCUMENT_DOCX","GENERATION_TEXT"] } },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "description":"Inclusive UTC end date; all filters precede pagination.", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": { "description": "Audited page; no count or cost", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "array", "items": { "type": "object", "required": ["id", "tenant_id", "tenant_name", "kind", "actual_credits", "settled_at"], "properties": { "id": { "type": "string", "format": "uuid" }, "tenant_id": { "type": "string", "format": "uuid" }, "tenant_name": { "type":"string", "maxLength":200 }, "kind": { "type": "string", "enum": ["DOCUMENT_PDF", "DOCUMENT_DOCX", "GENERATION_TEXT"] }, "actual_credits": { "type": "string", "pattern": "^[1-9][0-9]*$", "description": "Positive measured credits as an exact decimal string" }, "settled_at": { "type": "string", "format": "date-time" } } } }, "meta": { "type": "object", "required": ["trace_id", "next_cursor"], "properties": { "trace_id": { "type": "string" }, "next_cursor": { "type": ["string", "null"] } } } } } } } },
          "400": { "description": "Invalid request" }, "401": { "description": "Unauthenticated" }, "403": { "description": "Not authorized or assurance unavailable" }, "409": { "description": "Stale context" }, "503": { "description": "Read or audit unavailable; fail closed" }
        }
      }
    }
  }
}

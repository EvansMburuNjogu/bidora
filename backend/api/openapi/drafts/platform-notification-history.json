{
  "openapi": "3.1.0",
  "info": { "title": "PA-18 Platform notification attempt history (draft)", "version": "0.1.0" },
  "paths": {
    "/v1/platform/notifications/attempts": {
      "get": {
        "summary": "List platform-originated notification attempts, not recipient delivery",
        "description": "Current Platform Integration Administrator with matching context generation and recent TOTP-AAL2. Each page rechecks authority and commits a read audit in the same control transaction. Scope is tenant_id NULL and the four platform-originated categories with matching source types. Attempts without results have null disposition/failure_code/finished_at; SMTP_ACCEPTED means provider handoff, not delivery. No recipient identifiers, content, fingerprints, tokens, templates, tenant or identity records, exports or retry operations. Pagination is not a snapshot; newly started attempts may appear on a later first page.",
        "parameters": [
          { "name": "X-Bidora-Platform-Context-Generation", "in": "header", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "maxLength": 384 } }
        ],
        "responses": {
          "200": { "description": "Audited page without counts or recipient fields", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["category", "attempt_number", "disposition", "failure_code", "started_at", "finished_at"], "properties": { "category": { "type": "string", "enum": ["PLATFORM_INVITATION", "PLATFORM_SESSION_REVOCATION", "PLATFORM_IDENTITY_STATE_CHANGE", "PLATFORM_ROLE_CHANGE", "PLATFORM_TEMPLATE_TEST"] }, "attempt_number": { "type": "integer", "minimum": 1, "maximum": 100 }, "disposition": { "type": ["string", "null"], "enum": ["SMTP_ACCEPTED", "FAILED", "AMBIGUOUS", null] }, "failure_code": { "type": ["string", "null"], "enum": ["CONNECTIVITY_FAILED", "AUTHENTICATION_FAILED", "TLS_FAILED", "PROVIDER_REJECTED", "TIMEOUT", "PROCESS_INTERRUPTED", "PROVIDER_OUTCOME_UNKNOWN", "INTERNAL_ERROR", null] }, "started_at": { "type": "string", "format": "date-time" }, "finished_at": { "type": ["string", "null"], "format": "date-time" } } } }, "meta": { "type": "object", "required": ["trace_id", "next_cursor"], "properties": { "trace_id": { "type": "string" }, "next_cursor": { "type": ["string", "null"] } } } } } } } },
          "400": { "description": "Invalid request" }, "401": { "description": "Unauthenticated" }, "403": { "description": "Not authorised or assurance unavailable" }, "409": { "description": "Stale context" }, "503": { "description": "Read or audit unavailable; fail closed" }
        }
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": { "title": "PA-18 Platform notification attempt history (draft)", "version": "0.1.0" },
  "paths": {
    "/v1/platform/notifications/attempts": {
      "get": {
        "summary": "Filter system communications with protected recipients and secret-redacted message previews",
        "description": "Requires current Platform authority, matching context and recent administrator verification; read access is audited. Includes all categories and prepared-only notifications. Recipient/subject/message are nullable when not recorded or expired. New previews are secret-redacted before encrypted storage and governed by restricted metadata retention. Historical recipients are shown only when the current address matches the original keyed fingerprint. SMTP_ACCEPTED means handoff, not inbox delivery. No credentials, tokens, raw HTML, ciphertext or fingerprints are returned.",
        "parameters": [
          { "name": "X-Bidora-Platform-Context-Generation", "in": "header", "required": true, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "maxLength": 384 } },
          { "name": "category", "in": "query", "schema": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["NOT_ATTEMPTED","PENDING","SMTP_ACCEPTED","FAILED","AMBIGUOUS"] } },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Inclusive UTC date." }
        ],
        "responses": {
          "200": { "description": "Audited page of communication records; unavailable or expired details are null", "content": { "application/json": { "schema": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["recipient", "subject", "message", "category", "attempt_number", "disposition", "failure_code", "started_at", "finished_at"], "properties": { "recipient": { "type": ["string","null"], "maxLength": 254 }, "subject": { "type": ["string","null"], "maxLength": 600 }, "message": { "type": ["string","null"], "maxLength": 6100, "description": "Plain-text preview with secret tokens, codes and URLs removed; never raw HTML." }, "category": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$" }, "attempt_number": { "type": "integer", "description": "Zero means prepared with no delivery attempt; otherwise the delivery attempt number.", "minimum": 0, "maximum": 100 }, "disposition": { "type": ["string", "null"], "enum": ["SMTP_ACCEPTED", "FAILED", "AMBIGUOUS", null] }, "failure_code": { "type": ["string", "null"], "enum": ["CONNECTIVITY_FAILED", "AUTHENTICATION_FAILED", "TLS_FAILED", "PROVIDER_REJECTED", "TIMEOUT", "PROCESS_INTERRUPTED", "PROVIDER_OUTCOME_UNKNOWN", "INTERNAL_ERROR", null] }, "started_at": { "type": "string", "format": "date-time" }, "finished_at": { "type": ["string", "null"], "format": "date-time" } } } }, "meta": { "type": "object", "required": ["trace_id", "next_cursor"], "properties": { "trace_id": { "type": "string" }, "next_cursor": { "type": ["string", "null"] } } } } } } } },
          "400": { "description": "Invalid request" }, "401": { "description": "Unauthenticated" }, "403": { "description": "Not authorised or assurance unavailable" }, "409": { "description": "Stale context" }, "503": { "description": "Read or audit unavailable; fail closed" }
        }
      }
    }
  }
}

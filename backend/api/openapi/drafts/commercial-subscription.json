{
  "openapi": "3.1.0",
  "info": {
    "title": "Bidora Tenderpreneur plans and subscription management",
    "version": "0.2.0-draft",
    "description": "TP-F05 current-subscription read, one-lifetime trial start and period-end cancellation management. No payment-provider initiation or settlement is performed."
  },
  "paths": {
    "/v1/tenderpreneur/commercial/subscription": {
      "get": {
        "operationId": "getCommercialSubscription",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/TenantID"
          },
          {
            "$ref": "#/components/parameters/ContextGeneration"
          }
        ],
        "responses": {
          "200": {
            "description": "Current subscription, immutable term, limits and usage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/tenderpreneur/commercial/subscription/cancellation": {
      "post": {
        "operationId": "scheduleCommercialSubscriptionCancellation",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/TenantID"
          },
          {
            "$ref": "#/components/parameters/ContextGeneration"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifecycleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancellation scheduled at the current commercial-period boundary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/tenderpreneur/commercial/subscription/cancellation/withdraw": {
      "post": {
        "operationId": "withdrawCommercialSubscriptionCancellation",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/TenantID"
          },
          {
            "$ref": "#/components/parameters/ContextGeneration"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifecycleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scheduled cancellation withdrawn before its boundary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/tenderpreneur/commercial/subscription/trial": {
      "post": {
        "operationId": "startCommercialTrial",
        "description": "Starts the tenant's one-lifetime source-defined 14-day trial. Requires an active verified Organization Administrator membership, exact current context generation and explicit subscription-management ALLOW with deny precedence. Accepts no body or query.",
        "security": [
          {
            "browserSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/TenantID"
          },
          {
            "$ref": "#/components/parameters/ContextGeneration"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          }
        ],
        "responses": {
          "201": {
            "description": "Trial created or exact idempotent result replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrialStartResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bidora_session"
      }
    },
    "parameters": {
      "TenantID": {
        "name": "X-Bidora-Tenant-ID",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ContextGeneration": {
        "name": "X-Bidora-Context-Generation",
        "in": "header",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "schemas": {
      "LifecycleRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Subscription": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "subscription_id",
          "state",
          "access_mode",
          "version",
          "plan_key",
          "catalogue_version",
          "limits",
          "usage"
        ],
        "properties": {
          "subscription_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "access_mode": {
            "type": "string",
            "enum": [
              "FULL",
              "RETAINED_READ_ONLY",
              "LAST_RECONCILED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "plan_key": {
            "type": "string"
          },
          "catalogue_version": {
            "type": "string"
          },
          "limits": {
            "type": "object",
            "additionalProperties": true
          },
          "usage": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": true
      },
      "TrialStartResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subscription_id",
          "state",
          "version",
          "trial_ends_at",
          "replay"
        ],
        "properties": {
          "subscription_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "const": "TRIAL_ACTIVE"
          },
          "version": {
            "type": "integer",
            "const": 1
          },
          "trial_ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "replay": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Stable safe error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "x-status": "tp-f05-implemented-not-verified"
}

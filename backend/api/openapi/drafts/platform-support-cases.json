{
  "openapi": "3.1.0",
  "info": {
    "title": "Platform support cases (control metadata)",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/platform/support/cases": {
      "get": {
        "summary": "List control-owned support cases",
        "description": "Requires platform.support.case.read, recent administrator AAL2 and current context. Read is audited. Control metadata only, no tenant-private content.",
        "parameters": [
          {
            "name": "X-Bidora-Platform-Context-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 384
            }
          },
          { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["OPEN", "RESOLVED"] } },
          { "name": "assignment", "in": "query", "schema": { "type": "string", "enum": ["ASSIGNED", "UNASSIGNED"] } }
        ],
        "responses": {
          "200": {
            "description": "Bounded page, private no-store"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Stale context"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      },
      "post": {
        "summary": "Create a support case for a registered tenant",
        "description": "Requires platform.support.case.manage, recent administrator AAL2, current context, Origin, CSRF and idempotency. Atomic case, event, audit and command. No tenant database is opened.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Context"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/Idempotency"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tenant_id",
                  "title",
                  "description"
                ],
                "properties": {
                  "tenant_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay"
          },
          "201": {
            "description": "Case created"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Tenant not found"
          },
          "409": {
            "description": "Stale context or version conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfCookie": []
          }
        ]
      }
    },
    "/v1/platform/support/cases/{case_id}": {
      "get": {
        "summary": "Read a support case and at most 100 immutable replies",
        "description": "Requires platform.support.case.read, recent administrator AAL2 and current context; read is audited.",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Bidora-Platform-Context-Generation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Case and replies, private no-store"
          },
          "400": {
            "description": "Invalid"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Stale context"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/v1/platform/support/cases/{case_id}/assign": {
      "post": {
        "summary": "Assign an active Support Administrator",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/Context"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/Idempotency"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assignee_id",
                  "expected_version"
                ],
                "properties": {
                  "assignee_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned receipt"
          },
          "400": {
            "description": "Invalid"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Stale context or version conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfCookie": []
          }
        ]
      }
    },
    "/v1/platform/support/cases/{case_id}/reply": {
      "post": {
        "summary": "Append a support reply (up to 100)",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/Context"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/Idempotency"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message",
                  "expected_version"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned receipt"
          },
          "400": {
            "description": "Invalid"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Stale context or version conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfCookie": []
          }
        ]
      }
    },
    "/v1/platform/support/cases/{case_id}/resolve": {
      "post": {
        "summary": "Resolve an open support case",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/Context"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/Idempotency"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_version"
                ],
                "properties": {
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned receipt"
          },
          "400": {
            "description": "Invalid"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Stale context or version conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfCookie": []
          }
        ]
      }
    },
    "/v1/platform/support/cases/{case_id}/reopen": {
      "post": {
        "summary": "Reopen a resolved support case",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/Context"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CSRF"
          },
          {
            "$ref": "#/components/parameters/Idempotency"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_version"
                ],
                "properties": {
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned receipt"
          },
          "400": {
            "description": "Invalid"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Stale context or version conflict"
          },
          "503": {
            "description": "Unavailable"
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfCookie": []
          }
        ]
      }
    }
  },
  "components": {
    "parameters": {
      "Context": {
        "name": "X-Bidora-Platform-Context-Generation",
        "in": "header",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CSRF": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Idempotency": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}

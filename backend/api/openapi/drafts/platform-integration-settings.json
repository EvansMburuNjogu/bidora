{
  "openapi": "3.1.0",
  "info": {
    "title": "Bidora Platform Integration Settings",
    "version": "0.4.0-draft",
    "description": "Immutable SMTP, OpenAI and PesaPal settings use deployment-key encrypted write-only credentials, transactional receipts/audit/outbox, exact capabilities/current context/recent TOTP and maker/checker activation. OpenAI uses active managed configuration and store:false; tests require explicit possible-spend confirmation. PesaPal authentication tests create no orders, register no callbacks and prove no delivery/settlement. Live operations require separate deployment authorization. SMTP acceptance is not recipient delivery."
  },
  "x-status": "managed-integrations-source-provider-verification-separate",
  "x-approval": {"owner": "requesting user", "evidence": "Database-managed Platform SMTP configuration and conditional email OTP requested explicitly."},
  "x-runtime-mounted-operations": ["getActivePlatformIntegrationSetting", "listPlatformIntegrationSettingVersions", "getPlatformIntegrationSettingChange", "createPlatformIntegrationSettingVersion", "testPlatformIntegrationSettingVersion", "proposePlatformIntegrationSettingActivation", "approvePlatformIntegrationSettingChange", "rejectPlatformIntegrationSettingChange"],
  "paths": {
    "/v1/platform/integration-settings/OPENAI/models": {"get":{"operationId":"listPlatformOpenAIModels","description":"Supported managed Responses models; integration read/current context/recent TOTP. No provider call.","security":[{"browserSession":[]}],"parameters":[{"$ref":"#/components/parameters/PlatformContext"}],"responses":{"200":{"description":"Supported model IDs","content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["data","meta"],"properties":{"data":{"type":"array","maxItems":50,"items":{"type":"string"}},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},
    "/v1/platform/integration-settings/{setting_kind}": {
      "get": {
        "operationId": "getActivePlatformIntegrationSetting",
        "description": "Requires platform.integration.read, exact current platform context and TOTP-backed AAL2 no older than 15 minutes. Returns no secret reference or provider diagnostic.",
        "security": [{"browserSession": []}],
        "parameters": [{"$ref": "#/components/parameters/SettingKind"}, {"$ref": "#/components/parameters/PlatformContext"}],
        "responses": {
          "200": {"description": "Active redacted version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VersionResponse"}}}},
          "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/platform/integration-settings/{setting_kind}/versions": {
      "get": {
        "operationId": "listPlatformIntegrationSettingVersions",
        "description": "Requires platform.integration.read, exact current platform context and TOTP-backed AAL2 no older than 15 minutes. Returns bounded newest-sequence-first redacted history.",
        "security": [{"browserSession": []}],
        "parameters": [{"$ref": "#/components/parameters/SettingKind"}, {"$ref": "#/components/parameters/PlatformContext"}, {"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}],
        "responses": {"200": {"description": "Bounded redacted immutable version history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VersionListResponse"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      },
      "post": {
        "operationId": "createPlatformIntegrationSettingVersion",
        "security": [{"browserSession": []}],
        "parameters": [{"$ref": "#/components/parameters/SettingKind"}, {"$ref": "#/components/parameters/PlatformContext"}, {"$ref": "#/components/parameters/CSRF"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateVersionRequest"}}}},
        "responses": {"201": {"description": "Immutable untested draft version; encrypted secret material is never returned", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VersionResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/platform/integration-settings/{setting_kind}/versions/{version_id}/test": {
      "post": {
        "operationId": "testPlatformIntegrationSettingVersion",
        "description": "Runs one bounded synthetic provider test outside a SQL transaction, then immutably records the redacted result. SMTP targets the acting administrator's verified address; OpenAI uses no tenant data and store=false.",
        "security": [{"browserSession": []}],
        "parameters": [{"$ref": "#/components/parameters/SettingKind"}, {"$ref": "#/components/parameters/VersionID"}, {"$ref": "#/components/parameters/PlatformContext"}, {"$ref": "#/components/parameters/CSRF"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderTestRequest"}}}},
        "responses": {"200": {"description": "Redacted immutable test disposition", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VersionResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/platform/integration-settings/{setting_kind}/versions/{version_id}/activation-proposals": {
      "post": {
        "operationId": "proposePlatformIntegrationSettingActivation",
        "description": "Creates a 30-minute maker/checker proposal for an exact TEST_PASSED version. A rollback proposes activation of a previously active, still-compatible version whose latest test remains applicable.",
        "security": [{"browserSession": []}],
        "parameters": [{"$ref": "#/components/parameters/SettingKind"}, {"$ref": "#/components/parameters/VersionID"}, {"$ref": "#/components/parameters/PlatformContext"}, {"$ref": "#/components/parameters/CSRF"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ActivationProposalRequest"}}}},
        "responses": {"201": {"description": "Pending exact-version governance change", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChangeResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/platform/integration-setting-changes/{change_id}": {
      "get": {
        "operationId": "getPlatformIntegrationSettingChange",
        "description": "Requires platform.integration.read, exact current platform context and TOTP-backed AAL2 no older than 15 minutes. Expired pending changes are presented as EXPIRED without mutating history.",
        "security": [{"browserSession": []}],
        "parameters": [{"$ref": "#/components/parameters/ChangeID"}, {"$ref": "#/components/parameters/PlatformContext"}],
        "responses": {"200": {"description": "Safe governance-change detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChangeResponse"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/platform/integration-setting-changes/{change_id}/approve": {
      "post": {
        "operationId": "approvePlatformIntegrationSettingChange",
        "description": "A distinct effective Platform Owner approves and executes the exact unexpired change after rechecking both participants, active version, test applicability and policy.",
        "security": [{"browserSession": []}],
        "parameters": [{"$ref": "#/components/parameters/ChangeID"}, {"$ref": "#/components/parameters/PlatformContext"}, {"$ref": "#/components/parameters/CSRF"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReasonRequest"}}}},
        "responses": {"200": {"description": "Executed change and newly active redacted version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChangeExecutionResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/platform/integration-setting-changes/{change_id}/reject": {
      "post": {
        "operationId": "rejectPlatformIntegrationSettingChange",
        "security": [{"browserSession": []}],
        "parameters": [{"$ref": "#/components/parameters/ChangeID"}, {"$ref": "#/components/parameters/PlatformContext"}, {"$ref": "#/components/parameters/CSRF"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReasonRequest"}}}},
        "responses": {"200": {"description": "Rejected immutable change with no configuration effect", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChangeResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"browserSession": {"type": "apiKey", "in": "cookie", "name": "__Host-bidora_session"}},
    "parameters": {
      "SettingKind": {"name": "setting_kind", "in": "path", "required": true, "schema": {"type": "string", "enum": ["SMTP", "OPENAI", "PESAPAL"]}},
      "VersionID": {"name": "version_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ChangeID": {"name": "change_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "PlatformContext": {"name": "X-Bidora-Platform-Context-Generation", "in": "header", "required": true, "schema": {"type": "integer", "minimum": 1}},
      "CSRF": {"name": "X-CSRF-Token", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^\\\"[1-9][0-9]*\\\"$"}},
      "Cursor": {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 2048}},
      "Limit": {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}}
    },
    "schemas": {
      "Meta": {"type": "object", "additionalProperties": false, "required": ["trace_id"], "properties": {"trace_id": {"type": "string", "format": "uuid"}, "next_cursor": {"type": ["string", "null"]}}},
      "ReasonRequest": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": ".*\\S.*"}}},
      "BillableAITestRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "confirm_billable_test"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": ".*\\S.*"
          },
          "confirm_billable_test": {
            "const": true
          }
        }
      },
      "ProviderTestRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ReasonRequest"
          },
          {
            "$ref": "#/components/schemas/BillableAITestRequest"
          }
        ],
        "description": "OPENAI requires confirm_billable_test:true; SMTP/PESAPAL accept reason only."
      },
      "ActivationProposalRequest": {"type": "object", "additionalProperties": false, "required": ["action", "reason"], "properties": {"action": {"type": "string", "enum": ["ACTIVATE", "ROLLBACK"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": ".*\\S.*"}}},
      "CreateVersionRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CreateSMTPVersion"
          },
          {
            "$ref": "#/components/schemas/CreateOpenAIVersion"
          },
          {
            "$ref": "#/components/schemas/CreatePesaPalVersion"
          }
        ]
      },
      "CreateSMTPVersion": {
        "type": "object", "additionalProperties": false,
        "required": ["setting_kind", "host", "port", "username", "password", "trust_roots_pem", "sender_name", "sender_address", "reply_to_address", "connect_timeout_seconds", "command_timeout_seconds", "delivery_timeout_seconds", "max_concurrency", "reason"],
        "properties": {
          "setting_kind": {"const": "SMTP"}, "host": {"type": "string", "minLength": 1, "maxLength": 253}, "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "username": {"type": "string", "minLength": 1, "maxLength": 256}, "retain_credentials": {"type": "boolean", "description": "Keep the exact expected active SMTP credentials and trust configuration. Requires an empty password and unchanged username."}, "expected_active_version_id": {"type": "string", "format": "uuid"}, "expected_active_version": {"type": "integer", "minimum": 1}, "password": {"type": "string", "minLength": 0, "maxLength": 1024, "writeOnly": true, "description": "Required for first configuration or credential replacement; empty only with retain_credentials."}, "trust_roots_pem": {"type": "string", "minLength": 0, "maxLength": 24576, "writeOnly": true, "description": "Required on replacement; ignored when exact stored SMTP credentials/trust are retained."},
          "sender_name": {"type": "string", "minLength": 1, "maxLength": 200}, "sender_address": {"type": "string", "format": "email", "maxLength": 254}, "reply_to_address": {"type": ["string", "null"], "format": "email", "maxLength": 254},
          "connect_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30}, "command_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60}, "delivery_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 100},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": ".*\\S.*"}
        }
      },
      "CreateOpenAIVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "model",
          "timeout_seconds",
          "max_concurrency",
          "reason"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "model": {
            "type": "string",
            "enum": [
              "gpt-4.1-mini",
              "gpt-4.1",
              "gpt-4o-mini",
              "gpt-4o"
            ]
          },
          "api_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024,
            "writeOnly": true
          },
          "trust_roots_pem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "writeOnly": true
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 900
          },
          "max_concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": ".*\\S.*"
          }
        },
        "description": "Omitted replacements retain exact-active references transactionally; the first revision requires key and CA roots. Enabled=false is an explicitly testable pause. Environment credentials are ignored."
      },
      "CreatePesaPalVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "environment",
          "merchant_name",
          "notification_id",
          "reason",
          "retain_active_credentials"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "environment": {
            "type": "string",
            "enum": [
              "SANDBOX",
              "LIVE"
            ]
          },
          "merchant_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notification_id": {
            "type": "string",
            "description": "Pre-registered IPN UUID; empty only when disabled.",
            "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$"
          },
          "retain_active_credentials": {
            "type": "boolean"
          },
          "consumer_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512,
            "writeOnly": true
          },
          "consumer_secret": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512,
            "writeOnly": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": ".*\\S.*"
          }
        },
        "description": "Both replacements or retention of the exact-active encrypted pair. No caller-selected API/callback URL, callback registration, order, refund or settlement command."
      },
      "PesaPalRedactedConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "setting_kind",
          "enabled",
          "environment",
          "merchant_name",
          "credential_reference_configured",
          "notification_id",
          "api_endpoint"
        ],
        "properties": {
          "setting_kind": {
            "const": "PESAPAL"
          },
          "enabled": {
            "type": "boolean"
          },
          "environment": {
            "type": "string",
            "enum": [
              "SANDBOX",
              "LIVE"
            ]
          },
          "merchant_name": {
            "type": "string"
          },
          "credential_reference_configured": {
            "type": "boolean"
          },
          "notification_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "api_endpoint": {
            "type": "string",
            "enum": [
              "https://cybqa.pesapal.com/pesapalv3/api",
              "https://pay.pesapal.com/v3/api"
            ]
          }
        }
      },
      "SMTPRedactedConfiguration": {
        "type": "object", "additionalProperties": false,
        "required": ["setting_kind", "host", "port", "credential_reference_configured", "trust_roots_reference_configured", "starttls_required", "sender_name", "sender_address", "reply_to_address", "connect_timeout_seconds", "command_timeout_seconds", "delivery_timeout_seconds", "max_concurrency"],
        "properties": {"username": {"type": ["string", "null"], "description": "Login name populated only for the current authorized SMTP form; never returns the password."}, "setting_kind": {"const": "SMTP"}, "host": {"type": "string"}, "port": {"type": "integer"}, "credential_reference_configured": {"const": true}, "trust_roots_reference_configured": {"const": true}, "starttls_required": {"const": true}, "sender_name": {"type": "string"}, "sender_address": {"type": "string"}, "reply_to_address": {"type": ["string", "null"]}, "connect_timeout_seconds": {"type": "integer"}, "command_timeout_seconds": {"type": "integer"}, "delivery_timeout_seconds": {"type": "integer"}, "max_concurrency": {"type": "integer"}}
      },
      "OpenAIRedactedConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "setting_kind",
          "endpoint",
          "model",
          "api_key_reference_configured",
          "trust_roots_reference_configured",
          "store",
          "timeout_seconds",
          "max_concurrency",
          "enabled"
        ],
        "properties": {
          "setting_kind": {
            "const": "OPENAI"
          },
          "endpoint": {
            "const": "https://api.openai.com/v1/responses"
          },
          "model": {
            "type": "string"
          },
          "api_key_reference_configured": {
            "const": true
          },
          "trust_roots_reference_configured": {
            "const": true
          },
          "store": {
            "const": false
          },
          "timeout_seconds": {
            "type": "integer"
          },
          "max_concurrency": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "RedactedConfiguration": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SMTPRedactedConfiguration"
          },
          {
            "$ref": "#/components/schemas/OpenAIRedactedConfiguration"
          },
          {
            "$ref": "#/components/schemas/PesaPalRedactedConfiguration"
          }
        ],
        "discriminator": {
          "propertyName": "setting_kind"
        }
      },
      "IntegrationSettingVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "setting_kind",
          "sequence",
          "state",
          "version",
          "configuration",
          "test_status",
          "test_code",
          "created_at",
          "tested_at",
          "activated_at",
          "superseded_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "setting_kind": {
            "type": "string",
            "enum": [
              "SMTP",
              "OPENAI",
              "PESAPAL"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "TEST_PASSED",
              "TEST_FAILED",
              "PENDING_APPROVAL",
              "ACTIVE",
              "SUPERSEDED",
              "REJECTED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "configuration": {
            "$ref": "#/components/schemas/RedactedConfiguration"
          },
          "test_status": {
            "type": "string",
            "enum": [
              "NOT_TESTED",
              "PASSED",
              "FAILED"
            ]
          },
          "test_code": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "SMTP_STARTTLS_VERIFIED",
              "OPENAI_STRUCTURED_RESPONSE_VERIFIED",
              "CONNECTIVITY_FAILED",
              "AUTHENTICATION_FAILED",
              "TLS_FAILED",
              "PROVIDER_REJECTED",
              "INVALID_RESPONSE",
              "OPENAI_DISABLED_CONFIG_VERIFIED",
              "PESAPAL_AUTHENTICATION_VERIFIED",
              "PESAPAL_DISABLED_CONFIG_VERIFIED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "tested_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "activated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pending_change_id": {"type":["string","null"],"format":"uuid","description":"Authorized pending request linked to this saved OpenAI or PesaPal version; no manual reference entry is needed."},
          "superseded_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "IntegrationSettingChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "setting_kind",
          "target_version_id",
          "action",
          "state",
          "version",
          "maker_user_id",
          "checker_user_id",
          "expires_at",
          "created_at",
          "decided_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "setting_kind": {
            "type": "string",
            "enum": [
              "SMTP",
              "OPENAI",
              "PESAPAL"
            ]
          },
          "target_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "ACTIVATE",
              "ROLLBACK"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING_APPROVAL",
              "APPROVED_EXECUTED",
              "REJECTED",
              "EXPIRED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },

{
  "openapi": "3.1.0",
  "info": {"title": "Bidora account session inventory", "version": "0.3.0-draft"},
  "x-policy-status": "BID-ADR-022 approved and implemented; this inventory remains read-only",
  "x-policy-reference": "backend/docs/session-administration-policy.md",
  "paths": {
    "/v1/auth/sessions": {
      "get": {
        "summary": "List the current account's active browser sessions and revocation readiness",
        "description": "Requires the current authenticated session, exact approved HTTPS Origin and matching session-bound CSRF cookie. Returns no token hashes, IP addresses, user agents or inferred device locations.",
        "responses": {
          "200": {"description": "At most 100 current-auth-epoch sessions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionInventoryResponse"}}}},
          "400": {"description": "Body or query supplied"},
          "401": {"description": "Session invalid"},
          "403": {"description": "Origin or CSRF cookie rejected"},
          "409": {"description": "Bound exceeded"},
          "503": {"description": "Unavailable"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SessionInventoryItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "rotated_from_session_id", "current", "created_at", "last_seen_at", "idle_expires_at", "absolute_expires_at"],
        "properties": {
          "session_id": {"type": "string", "format": "uuid"},
          "rotated_from_session_id": {"type": ["string", "null"], "format": "uuid"},
          "current": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"},
          "last_seen_at": {"type": "string", "format": "date-time"},
          "idle_expires_at": {"type": "string", "format": "date-time"},
          "absolute_expires_at": {"type": "string", "format": "date-time"}
        }
      },
      "SessionInventoryData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["active_session_count", "other_session_count", "sessions", "current_session_logout_available", "other_session_revocation_available", "revoke_all_available", "revocation_policy_configured", "device_metadata_collected", "blockers", "observed_at"],
        "properties": {
          "active_session_count": {"type": "integer", "minimum": 1, "maximum": 100},
          "other_session_count": {"type": "integer", "minimum": 0, "maximum": 99},
          "sessions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/components/schemas/SessionInventoryItem"}},
          "current_session_logout_available": {"type": "boolean"},
          "other_session_revocation_available": {"type": "boolean"},
          "revoke_all_available": {"type": "boolean"},
          "revocation_policy_configured": {"type": "boolean"},
          "device_metadata_collected": {"type": "boolean", "const": false},
          "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      },
      "Meta": {"type": "object", "additionalProperties": false, "required": ["trace_id"], "properties": {"trace_id": {"type": "string", "format": "uuid"}}},
      "SessionInventoryResponse": {"type": "object", "additionalProperties": false, "required": ["data", "meta"], "properties": {"data": {"$ref": "#/components/schemas/SessionInventoryData"}, "meta": {"$ref": "#/components/schemas/Meta"}}}
    }
  }
}

{
  "openapi":"3.1.0",
  "info":{"title":"Bidora Commercial Adjustment Governance","version":"0.1.0-draft","description":"BID-API-011C4 unmounted maker/checker contract. Provider refund execution, cash settlement and entitlement disposition execution are excluded."},

  "paths":{
    "/v1/platform/commercial/financial-adjustments":{"post":{"operationId":"proposeCommercialFinancialAdjustment","description":"Billing Administrator with fresh AAL2/TOTP proposes an adjustment against a server-resolved settled invoice. No tenant, cell or database routing selector is accepted.","security":[{"browserSession":[],"csrfCookie":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/CSRF"},{"$ref":"#/components/parameters/Context"},{"$ref":"#/components/parameters/Idempotency"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Proposal"}}}},"responses":{"201":{"description":"Pending distinct-owner approval; no credit, refund or entitlement effect yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdjustmentResponse"}}}},"400":{"$ref":"#/components/responses/Failure"},"401":{"$ref":"#/components/responses/Failure"},"403":{"$ref":"#/components/responses/Failure"},"409":{"$ref":"#/components/responses/Failure"},"503":{"$ref":"#/components/responses/Failure"}}}},
    "/v1/platform/commercial/financial-adjustments/{change_id}/decision":{"post":{"operationId":"decideCommercialFinancialAdjustment","description":"A distinct Platform Owner with fresh AAL2/TOTP approves or rejects within 30 minutes. Approval issues an immutable credit note and, for refunds, records only a provider-neutral APPROVED refund intent.","security":[{"browserSession":[],"csrfCookie":[]}],"parameters":[{"name":"change_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/CSRF"},{"$ref":"#/components/parameters/Context"},{"$ref":"#/components/parameters/Idempotency"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Decision"}}}},"responses":{"200":{"description":"Immutable approval/rejection result. APPROVED refund remains unexecuted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdjustmentResponse"}}}},"400":{"$ref":"#/components/responses/Failure"},"401":{"$ref":"#/components/responses/Failure"},"403":{"$ref":"#/components/responses/Failure"},"404":{"$ref":"#/components/responses/Failure"},"409":{"$ref":"#/components/responses/Failure"},"503":{"$ref":"#/components/responses/Failure"}}}}
  },
  "components":{
    "securitySchemes":{"browserSession":{"type":"apiKey","in":"cookie","name":"__Host-bidora_session"},"csrfCookie":{"type":"apiKey","in":"cookie","name":"__Host-bidora_csrf"}},
    "parameters":{"Origin":{"name":"Origin","in":"header","required":true,"schema":{"type":"string","format":"uri"}},"CSRF":{"name":"X-CSRF-Token","in":"header","required":true,"schema":{"type":"string","minLength":43,"maxLength":43}},"Context":{"name":"X-Bidora-Context-Generation","in":"header","required":true,"schema":{"type":"integer","minimum":1}},"Idempotency":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","format":"uuid"}}},

{
  "openapi":"3.1.0",
  "info":{"title":"Bidora Commercial Adjustment Governance","version":"0.1.0-draft","description":"BE-SIM-03 mounted maker/checker commands. Provider refund execution, cash settlement and entitlement disposition execution are excluded; production refund policy requires confirmation."},
  "x-status":"source-connected-not-live-verified",
  "x-policy":"BID-API-011C C1-C15",
  "paths":{
    "/v1/platform/commercial/financial-adjustments":{"post":{"operationId":"proposeCommercialFinancialAdjustment","description":"Billing Administrator with fresh AAL2/TOTP proposes an adjustment against a server-resolved settled invoice. New refund proposals are forbidden until a separately approved provider-contract-bounded policy window is explicitly configured; zero disables refunds. No tenant, cell or database routing selector is accepted.","security":[{"browserSession":[],"csrfCookie":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/CSRF"},{"$ref":"#/components/parameters/Context"},{"$ref":"#/components/parameters/Idempotency"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Proposal"}}}},"responses":{"201":{"description":"Pending distinct-owner approval; no credit, refund or entitlement effect yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdjustmentResponse"}}}},"400":{"$ref":"#/components/responses/Failure"},"401":{"$ref":"#/components/responses/Failure"},"403":{"$ref":"#/components/responses/Failure"},"409":{"$ref":"#/components/responses/Failure"},"503":{"$ref":"#/components/responses/Failure"}}}},
    "/v1/platform/commercial/financial-adjustments/{change_id}/decision":{"post":{"operationId":"decideCommercialFinancialAdjustment","description":"A distinct Platform Owner with fresh AAL2/TOTP approves or rejects within 30 minutes. Refund approval is forbidden while the policy window is disabled. Approval issues an immutable credit note and, for refunds, records only a provider-neutral APPROVED refund intent.","security":[{"browserSession":[],"csrfCookie":[]}],"parameters":[{"name":"change_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/CSRF"},{"$ref":"#/components/parameters/Context"},{"$ref":"#/components/parameters/Idempotency"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Decision"}}}},"responses":{"200":{"description":"Immutable approval/rejection result. APPROVED refund remains unexecuted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdjustmentResponse"}}}},"400":{"$ref":"#/components/responses/Failure"},"401":{"$ref":"#/components/responses/Failure"},"403":{"$ref":"#/components/responses/Failure"},"404":{"$ref":"#/components/responses/Failure"},"409":{"$ref":"#/components/responses/Failure"},"503":{"$ref":"#/components/responses/Failure"}}}}
  },
  "components":{
    "securitySchemes":{"browserSession":{"type":"apiKey","in":"cookie","name":"__Host-bidora_session"},"csrfCookie":{"type":"apiKey","in":"cookie","name":"__Host-bidora_csrf"}},
    "parameters":{"Origin":{"name":"Origin","in":"header","required":true,"schema":{"type":"string","format":"uri"}},"CSRF":{"name":"X-CSRF-Token","in":"header","required":true,"schema":{"type":"string","minLength":43,"maxLength":43}},"Context":{"name":"X-Bidora-Platform-Context-Generation","in":"header","required":true,"schema":{"type":"integer","minimum":1}},"Idempotency":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","format":"uuid"}}},
    "schemas":{
      "Proposal":{"type":"object","additionalProperties":false,"required":["invoice_id","action","reason_code","amount_minor_units","entitlement_disposition","proposal_reason","expected_invoice_version","expected_payment_version"],"properties":{"invoice_id":{"type":"string","format":"uuid"},"action":{"type":"string","enum":["ISSUE_CREDIT","REQUEST_REFUND"]},"reason_code":{"type":"string","enum":["SERVICE_CREDIT","DUPLICATE_PAYMENT_REFUND","SERVICE_FAILURE_REFUND","PAYMENT_REVERSAL_CORRECTION","OTHER_CONTRACTUAL_REFUND"]},"amount_minor_units":{"type":"integer","minimum":1},"entitlement_disposition":{"type":"string","enum":["NO_ENTITLEMENT_CHANGE","REDUCE_ADDITIONAL_LICENCES_AT_RENEWAL","END_PAID_ACCESS_ON_REFUND_SETTLEMENT","REVIEW_REQUIRED"]},"proposal_reason":{"type":"string","minLength":1,"maxLength":2000},"expected_invoice_version":{"type":"integer","minimum":1},"expected_payment_version":{"type":"integer","minimum":1}}},
      "Decision":{"type":"object","additionalProperties":false,"required":["decision","reason","expected_version"],"properties":{"decision":{"type":"string","enum":["APPROVED","REJECTED"]},"reason":{"type":"string","minLength":1,"maxLength":2000},"expected_version":{"type":"integer","minimum":1}}},
      "AdjustmentResponse":{"type":"object","additionalProperties":false,"required":["data","meta"],"properties":{"data":{"type":"object","additionalProperties":false,"required":["id","invoice_id","payment_id","action","state","version","reason_code","amount","net","tax","entitlement_disposition","expires_at","credit_note_id","credit_number","refund_operation_id","provider_refund_executed","entitlement_disposition_executed"],"properties":{"id":{"type":"string","format":"uuid"},"invoice_id":{"type":"string","format":"uuid"},"payment_id":{"type":"string","format":"uuid"},"action":{"type":"string","enum":["ISSUE_CREDIT","REQUEST_REFUND"]},"state":{"type":"string","enum":["PENDING_APPROVAL","APPROVED","REJECTED"]},"version":{"type":"integer","minimum":1},"reason_code":{"type":"string"},"amount":{"$ref":"#/components/schemas/Money"},"net":{"$ref":"#/components/schemas/Money"},"tax":{"$ref":"#/components/schemas/Money"},"entitlement_disposition":{"type":"string"},"expires_at":{"type":"string","format":"date-time"},"credit_note_id":{"type":["string","null"],"format":"uuid"},"credit_number":{"type":["string","null"]},"refund_operation_id":{"type":["string","null"],"format":"uuid"},"provider_refund_executed":{"type":"boolean","const":false},"entitlement_disposition_executed":{"type":"boolean","const":false}}},"meta":{"type":"object","additionalProperties":false,"required":["trace_id","next_cursor"],"properties":{"trace_id":{"type":"string"},"next_cursor":{"type":"null"}}}}},
      "Money":{"type":"object","additionalProperties":false,"required":["currency","amount_minor_units","amount"],"properties":{"currency":{"const":"KES"},"amount_minor_units":{"type":"integer","minimum":0},"amount":{"type":"string","pattern":"^[0-9]+\\.[0-9]{2}$"}}},
      "Error":{"type":"object","additionalProperties":false,"required":["error"],"properties":{"error":{"type":"object"}}}
    },
    "responses":{"Failure":{"description":"Stable safe failure including commercial_refund_not_permitted, commercial_adjustment_approval_required, conflict or dependency unavailable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}
  }
}

    "responses":{"Failure":{"description":"Stable safe failure including commercial_refund_not_permitted, commercial_adjustment_approval_required, conflict or dependency unavailable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}
